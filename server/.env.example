# Neon Postgres connection string (get this from the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/devin_clone?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — used only for the user's login (OAuth). See GITHUB_TOKEN below for
# the separate token the agent uses to actually push code and open PRs.
# Authorization callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Personal access token (classic, "repo" scope, or a fine-grained token with
# Contents + Pull requests write access) for repos the agent should push to.
# https://github.com/settings/tokens — this is DIFFERENT from GITHUB_CLIENT_ID/SECRET
# above (that pair is for user login; this token is what the agent uses to write).
# Leave blank to keep the agent working in a throwaway scratch workspace only —
# no clone, no push, no PR.
GITHUB_TOKEN=

# Desktop tab — best-effort, requires the `docker` CLI installed and running on
# this server's host. Leave DESKTOP_DOCKER_IMAGE unset to use the default
# (consol/ubuntu-xfce-vnc). Not testable in a sandboxed/managed environment
# without Docker access — see server/README.md.
DESKTOP_DOCKER_IMAGE=

# Stripe — https://dashboard.stripe.com/test/apikeys (test mode is free).
# STRIPE_PRICE_ID_TEAM is the Price ID for the Team plan's recurring price
# (dashboard.stripe.com/test/products). Leave these blank to keep every user on
# the Free plan with just the 14-day trial — Settings → Billing will say billing
# isn't configured instead of erroring.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TEAM=

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Gemini — free tier key from https://aistudio.google.com/apikey
# Powers the agent execution engine (file/shell tool-calling loop).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Slack OAuth — https://api.slack.com/apps -> your app -> OAuth & Permissions
# Redirect URL: http://localhost:4000/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Linear OAuth — https://linear.app/settings/api/applications
# Callback URL: http://localhost:4000/api/integrations/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Jira (Atlassian OAuth 2.0 3LO) — https://developer.atlassian.com/console/myapps/
# Callback URL: http://localhost:4000/api/integrations/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
